{
  "manifest_version": 3,
  "name": "ScratchDream",
  "version": "2.6.0",
  "description": "A safe one-click project optimizer, pixel snapping, shape and pen tools, masks, layers, animation anchor, sprite folders, a plan board, a load diet, live home panels and the users2 profile API for Scratch and the TurboWarp costume editor.",
  "action": {
    "default_title": "ScratchDream",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "diet",
        "enabled": true,
        "path": "rules/diet.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://turbowarp.org/*",
        "https://*.turbowarp.org/*",
        "https://scratch.mit.edu/*",
        "https://penguinmod.com/*",
        "https://*.penguinmod.com/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "adox-kostum.js",
        "lame.min.js",
        "optimizer.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://turbowarp.org/*",
        "https://*.turbowarp.org/*",
        "https://scratch.mit.edu/*",
        "https://penguinmod.com/*",
        "https://*.penguinmod.com/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://scratch.mit.edu/projects/*",
        "https://scratch.mit.edu/users/*"
      ],
      "js": [
        "comment-quote.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://scratch.mit.edu/*"
      ],
      "js": [
        "homepage.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://scratch.mit.edu/discuss/*"
      ],
      "js": [
        "forum.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://scratch.mit.edu/explore/projects/*"
      ],
      "js": [
        "explore.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://scratch.mit.edu/users/*"
      ],
      "js": [
        "project-stats.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://scratch.mit.edu/*",
        "https://api.scratch.mit.edu/*"
      ],
      "js": [
        "users2.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/logo-64.png",
        "sf-logo.svg"
      ],
      "matches": [
        "https://scratch.mit.edu/*"
      ]
    }
  ]
}
